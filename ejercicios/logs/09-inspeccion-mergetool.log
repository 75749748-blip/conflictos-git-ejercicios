### MERGECOLL - HERRAMIENTA PERSONALIZADA ###

$ cat resolver.sh
#!/usr/bin/env bash
# Herramienta de merge no interactiva para la demostracion.
# Argumentos de git mergetool: BASE LOCAL REMOTE MERGED
printf 'valor = 5\n' > "$4"
exit 0

$ git config merge.tool resolver

$ git config mergetool.prompt false

$ git config mergetool.resolver.cmd "/c/Users/gambo/Documents/Git-Conflictos/.work/ejercicio-09-inspeccion/resolver.sh "$BASE" "$LOCAL" "$REMOTE" "$MERGED""

