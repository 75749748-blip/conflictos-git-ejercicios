### PREPARACION ###

$ git init -b main
Initialized empty Git repository in C:/Users/gambo/Documents/Git-Conflictos/.work/ejercicio-01-linea/.git/

$ git config user.name Alumno

$ git config user.email alumno@example.com

$ git config merge.conflictStyle zdiff3

$ printf 'linea 1\nlinea 2\nlinea 3\n' > app.txt

$ git add app.txt

$ git commit -m "base: crea app.txt"
