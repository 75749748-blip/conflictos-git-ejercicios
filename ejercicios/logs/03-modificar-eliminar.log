### PREPARACION ###

$ git init -b main
Initialized empty Git repository in C:/Users/gambo/Documents/Git-Conflictos/.work/ejercicio-03-mod-delete/.git/

$ git config user.name Alumno

$ git config user.email alumno@example.com

$ git config merge.conflictStyle zdiff3

$ printf 'uno\ndos\ntres\n' > notas.txt

$ git add notas.txt

$ git commit -m "base: crea notas.txt"
[main (root-commit) fc4c203] base: crea notas.txt
 1 file changed, 3 insertions(+)
 create mode 100644 notas.txt

$ git switch -c feature
Switched to a new branch 'feature'

$ git rm notas.txt
rm 'notas.txt'

$ git commit -m "feature: elimina notas.txt"
[feature 9a4a797] feature: elimina notas.txt
 1 file changed, 3 deletions(-)
 delete mode 100644 notas.txt

$ git switch main
Switched to branch 'main'

$ printf 'uno\ndos (main)\ntres\n' > notas.txt

$ git commit -am "main: edita notas.txt"
[main 2e46dff] main: edita notas.txt
 1 file changed, 1 insertion(+), 1 deletion(-)

### CONFLICTO ###

$ git merge feature
