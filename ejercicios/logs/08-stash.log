### PREPARACION ###

$ git init -b main
Initialized empty Git repository in C:/Users/gambo/Documents/Git-Conflictos/.work/ejercicio-08-stash/.git/

$ git config user.name Alumno

$ git config user.email alumno@example.com

$ git config merge.conflictStyle zdiff3

$ printf 'linea 1\nlinea 2\nlinea 3\n' > app.txt

$ git add app.txt

$ git commit -m base
[main (root-commit) 81d48fd] base
 1 file changed, 3 insertions(+)
 create mode 100644 app.txt

$ printf 'linea 1\nlinea 2 (WIP)\nlinea 3\n' > app.txt

$ git stash push -m "wip: linea 2"
Saved working directory and index state On main: wip: linea 2

$ git stash list
stash@{0}: On main: wip: linea 2

$ printf 'linea 1\nlinea 2 (commit)\nlinea 3\n' > app.txt

$ git commit -am "main: cambia la linea 2"
[main 47aa934] main: cambia la linea 2
 1 file changed, 1 insertion(+), 1 deletion(-)

### CONFLICTO ###

$ git stash pop
Auto-merging app.txt
CONFLICT (content): Merge conflict in app.txt
On branch main
Unmerged paths:
  (use "git restore --staged <file>..." to unstage)
  (use "git add <file>..." to mark resolution)
	both modified:   app.txt

no changes added to commit (use "git add" and/or "git commit -a")
The stash entry is kept in case you need it again.
[exit 1]

$ git status --short
UU app.txt

$ git stash list
stash@{0}: On main: wip: linea 2

$ cat app.txt
linea 1
<<<<<<< Updated upstream
linea 2 (commit)
||||||| Stash base
linea 2
=======
linea 2 (WIP)
>>>>>>> Stashed changes
linea 3

### RESOLUCION ###

$ printf 'linea 1\nlinea 2 (commit + WIP)\nlinea 3\n' > app.txt

$ cat app.txt
linea 1
linea 2 (commit + WIP)
linea 3

$ git add app.txt

$ git stash drop
Dropped refs/stash@{0} (68970ab2e34d53e7a1a9d91b810da6354499c8cf)

$ git commit -m "feat: recupera el WIP combinado con el cambio de main"
[main c295e96] feat: recupera el WIP combinado con el cambio de main
 1 file changed, 1 insertion(+), 1 deletion(-)

